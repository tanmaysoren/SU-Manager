<?xml version="1.0" encoding="utf-8"?>
<!--
GPS Mocker, as a library inside SU-Manager: the app it is built into owns everything
that belongs to the app as a whole - the icon, the label, the theme, the backup rules.
What is left here is what makes up the mocker: its screens, the mock-location
foreground service and the quick-settings tile.

There is no launcher intent-filter either: the screens open from the host's Labs page,
and a second launcher entry for the same package would just be a second way to reach
the same app. The VPN suite and the accessibility re-connector that came with it are
not here at all, so the VPN-related permissions and queries are gone with them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication" />

        <service
            android:name=".service.MockLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.SpooferTileService"
            android:icon="@android:drawable/ic_menu_mylocation"
            android:label="GPS Mocker"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
