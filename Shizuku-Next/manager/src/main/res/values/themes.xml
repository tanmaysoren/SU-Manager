<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.ShizukuAppTheme.Light" parent="Theme.Material3Expressive.Light.Shizuku">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#B3000000</item>

        <!-- Android 10 (API 29) attribute: ignored by older platforms, which is why it is
             declared here rather than in a values-v29 copy of the whole theme. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="preferenceTheme">@style/ShizukuAppTheme.PreferenceThemeOverlay</item>

        <item name="appColorPrimary">@color/app_color_light</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ShizukuTheme.Light" parent="Base.ShizukuAppTheme.Light" />

    <style name="Base.ShizukuAppTheme" parent="Theme.Material3Expressive.Dark.Shizuku">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#B3000000</item>

        <!-- Android 10 (API 29) attribute: ignored by older platforms, which is why it is
             declared here rather than in a values-v29 copy of the whole theme. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="preferenceTheme">@style/ShizukuAppTheme.PreferenceThemeOverlay</item>
        
        <item name="appColorPrimary">@color/app_color_dark</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="ShizukuTheme" parent="Base.ShizukuAppTheme" />

    <style name="ShizukuAppTheme.PreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay.Rikka.Material3">
        <item name="switchPreferenceCompatStyle">@style/Preference.Rikka.MateriaSwitchPreference</item>
    </style>

</resources>